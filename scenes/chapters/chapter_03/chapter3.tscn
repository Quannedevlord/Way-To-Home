[gd_scene format=3]
; Cấu hình Chương 3: kế thừa UI chung, đặt ID/tên chương, JSON, avatar và nhạc khởi đầu.
; chapter3.gd kế thừa StoryChapter để dùng cờ và manh mối xuyên chương.

[ext_resource type="PackedScene" path="res://scenes/chapters/base/chapter_base.tscn" id="1_base"]
[ext_resource type="Script" path="res://scenes/chapters/chapter_03/chapter3.gd" id="2_script"]
[ext_resource type="AudioStream" path="res://assets/backgrounds/audio/bgm/in game3.mp3" id="3_bgm"]

[node name="Chapter3" instance=ExtResource("1_base")]
script = ExtResource("2_script")
chapter_id = "chapter_03"
chapter_name = "Chương 3 · Người vắng mặt trong bức ảnh"
story_path = "res://data/story/chapter_03.json"
avatar_paths = {
"Kiên": "res://assets/avatars/Avatar_Kien.png",
"Thư": "res://assets/avatars/Avatar_Thu.png",
"Vy": "res://assets/avatars/Avatar_Vy.png"
}
protagonist_speakers = Array[String](["Kiên"])
choice_speaker = "Kiên"
default_music = ExtResource("3_bgm")
