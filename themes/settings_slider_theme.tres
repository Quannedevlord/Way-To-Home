[gd_resource type="Theme" format=3 uid="uid://qaags6f804rn"]
; Theme riêng của thanh trượt âm lượng: rãnh, phần đã kéo và núm ở ba trạng thái.
; Sửa các StyleBox bên dưới để đổi màu/viền; hình núm lấy từ các SVG trong assets.

[ext_resource type="Texture2D" uid="uid://cry48wvaqtuns" path="res://assets/backgrounds/ui/settings/slider_grabber.svg" id="1_grabber"]
[ext_resource type="Texture2D" uid="uid://dsvp2qtwiasak" path="res://assets/backgrounds/ui/settings/slider_grabber_highlight.svg" id="2_highlight"]
[ext_resource type="Texture2D" uid="uid://dvoqssruwpsau" path="res://assets/backgrounds/ui/settings/slider_grabber_disabled.svg" id="3_disabled"]

