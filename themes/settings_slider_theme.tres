[resource]
; Gán texture và style cho HSlider; dùng chung giữa thanh Music và SFX.
HSlider/constants/center_grabber = 0
HSlider/constants/grabber_offset = 0
HSlider/icons/grabber = ExtResource("1_grabber")
HSlider/icons/grabber_disabled = ExtResource("3_disabled")
HSlider/icons/grabber_highlight = ExtResource("2_highlight")
HSlider/styles/grabber_area = SubResource("StyleBoxFlat_fill")
HSlider/styles/grabber_area_highlight = SubResource("StyleBoxFlat_fill_highlight")
HSlider/styles/slider = SubResource("StyleBoxFlat_track")
